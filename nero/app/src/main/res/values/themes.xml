<resources>
    <style name="Theme.Nero" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nero_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Folha do assistente: translúcida, desfoca o que está atrás (Android 12+). -->
    <style name="Theme.Nero.Sheet" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/NeroSheetAnim</item>
    </style>

    <style name="Theme.Nero.Invisible" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Janelas flutuantes da ilha. -->
    <style name="Theme.Nero.Overlay" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowElevation">0dp</item>
        <item name="android:windowMinWidthMajor">0%</item>
        <item name="android:windowMinWidthMinor">0%</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
    </style>

    <style name="NeroPopAnim">
        <item name="android:windowEnterAnimation">@anim/nero_pop_in</item>
        <item name="android:windowExitAnimation">@anim/nero_pop_out</item>
    </style>
    <style name="NeroPanelAnim">
        <item name="android:windowEnterAnimation">@anim/nero_panel_in</item>
        <item name="android:windowExitAnimation">@anim/nero_panel_out</item>
    </style>
    <style name="NeroSheetAnim">
        <item name="android:activityOpenEnterAnimation">@anim/nero_panel_in</item>
        <item name="android:activityCloseExitAnimation">@anim/nero_panel_out</item>
        <item name="android:windowEnterAnimation">@anim/nero_panel_in</item>
        <item name="android:windowExitAnimation">@anim/nero_panel_out</item>
    </style>
</resources>
